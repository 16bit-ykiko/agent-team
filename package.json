{
  "name": "agent-team",
  "description": "Multi-agent orchestration panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "cd webview-ui && npm install",
    "build:server": "node esbuild.js",
    "build:webview": "cd webview-ui && npm run build",
    "build": "npm run build:webview && npm run build:server",
    "watch:server": "node esbuild.js --watch",
    "test": "vitest run && npm --prefix webview-ui run test",
    "test:watch": "vitest",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.3.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.195",
    "@iarna/toml": "^2.2.5",
    "@types/ws": "^8.18.1",
    "ws": "^8.20.0"
  }
}
