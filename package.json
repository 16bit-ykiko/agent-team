{
  "name": "agent-team",
  "description": "Multi-agent orchestration panel",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "service",
    "webview"
  ],
  "scripts": {
    "build": "npm run build -w webview && npm run build -w service",
    "test": "npm run test -w service && npm run test -w webview",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run fmt:check"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.3.0",
    "typescript-eslint": "^8.69.0",
    "typescript": "^5.8.0"
  },
  "type": "module"
}
